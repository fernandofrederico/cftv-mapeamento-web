<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> | CFTV Mapeamento</title>
  <link rel="stylesheet" href="/css/app-shell.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'mapa', usuario: usuario }) %>

    <main class="main map-page">
      <header class="topbar">
        <div>
          <p class="eyebrow">Infraestrutura de CFTV</p>
          <h1>Mapa</h1>
        </div>
      </header>

      <div class="content">
        <div class="map-toolbar">
          <p>
            <% if (caixas.length === 0) { %>
              Nenhuma caixa cadastrada ainda.
            <% } else { %>
              Arraste os marcadores para reposicionar cada caixa no mapa.
            <% } %>
          </p>

          <form
            class="upload-form"
            action="/mapa/imagem"
            method="post"
            enctype="multipart/form-data"
          >
            <label class="btn secondary" for="mapaArquivo">
              <%= imagemMapa ? 'Trocar imagem do mapa' : 'Enviar imagem do mapa' %>
            </label>
            <input
              id="mapaArquivo"
              name="mapa"
              type="file"
              accept=".png,.jpg,.jpeg,.webp"
              onchange="this.form.submit()"
            >
          </form>
        </div>

        <% if (erroUpload) { %>
          <div class="alert-error" style="margin:14px 22px;padding:12px;border-radius:8px;background:#fff0f0;color:#9c3030;border:1px solid #e6b7b7;font-size:13px;">
            <%= erroUpload %>
          </div>
        <% } %>

        <div class="map-viewport" id="mapViewport">
          <% if (!imagemMapa) { %>
            <div class="map-empty">
              <div class="empty-state">
                <h3>Nenhum mapa enviado</h3>
                <p>Envie uma imagem para começar a posicionar as caixas.</p>
              </div>
            </div>
          <% } else { %>
            <div class="map-stage" id="mapStage">
              <img
                id="mapImage"
                class="map-image"
                src="<%= imagemMapa %>"
                alt="Mapa"
              >
              <div class="markers-layer" id="markersLayer">
                <% caixas.forEach((caixa) => { %>
                  <div
                    class="marker"
                    data-id="<%= caixa.id %>"
                    data-codigo="<%= caixa.codigo %>"
                    style="left:<%= caixa.pos_x %>px; top:<%= caixa.pos_y %>px;"
                  >
                    <span class="marker-icon" aria-hidden="true">▦</span>
                    <span class="marker-label"><%= caixa.codigo %></span>
                  </div>
                <% }); %>
              </div>
            </div>
          <% } %>
        </div>

        <% if (imagemMapa && caixas.length > 0) { %>
          <p class="map-help">Arraste um marcador para reposicionar • a posição é salva automaticamente</p>
        <% } %>
      </div>
    </main>
  </div>

  <div class="modal-backdrop hidden" id="caixaModalBackdrop">
    <div class="modal large">
      <header class="modal-head">
        <h2 id="caixaModalTitulo">Caixa</h2>
        <button type="button" class="close-x" id="caixaModalFechar" aria-label="Fechar">&times;</button>
      </header>

      <div class="tabs">
        <button type="button" class="tab active" data-tab="geral">Painel e switch</button>
        <button type="button" class="tab" data-tab="portas">Portas e câmeras</button>
      </div>

      <div id="tab-geral" class="tab-panel active">
        <dl class="caixa-modal-details">
          <div>
            <dt>Descrição</dt>
            <dd id="caixaModalDescricao">—</dd>
          </div>
          <div>
            <dt>Localização</dt>
            <dd id="caixaModalLocalizacao">—</dd>
          </div>
          <div>
            <dt>Switch</dt>
            <dd id="caixaModalSwitch">—</dd>
          </div>
          <div>
            <dt>IP do switch</dt>
            <dd><code id="caixaModalIp">—</code></dd>
          </div>
        </dl>

        <div class="images-grid">
          <div class="image-card">
            <h3>Foto interna da caixa/painel</h3>
            <div class="image-preview" id="caixaModalFotoPainel">Nenhuma imagem</div>
            <label class="btn secondary file-btn troca-foto-btn">
              Trocar foto
              <input type="file" id="caixaModalTrocarPainel" accept=".png,.jpg,.jpeg,.webp">
            </label>
          </div>
          <div class="image-card">
            <h3>Foto frontal do switch PoE</h3>
            <div class="image-preview" id="caixaModalFotoSwitch">Nenhuma imagem</div>
            <label class="btn secondary file-btn troca-foto-btn">
              Trocar foto
              <input type="file" id="caixaModalTrocarSwitch" accept=".png,.jpg,.jpeg,.webp">
            </label>
          </div>
        </div>
      </div>

      <div id="tab-portas" class="tab-panel">
        <p>Vermelho = ocupada · verde = livre. Clique numa porta ocupada para ver a câmera.</p>
        <div id="caixaModalPortasGrid" class="ports-grid"></div>

        <div id="caixaModalCameraDetalhe" class="camera-detalhe hidden">
          <h4 id="cameraDetalheTitulo">Porta</h4>
          <dl class="caixa-modal-details">
            <div>
              <dt>Número da câmera</dt>
              <dd id="cameraDetalheNumero">—</dd>
            </div>
            <div>
              <dt>Descrição</dt>
              <dd id="cameraDetalheNome">—</dd>
            </div>
            <div>
              <dt>IP</dt>
              <dd id="cameraDetalheIp">—</dd>
            </div>
            <div>
              <dt>Localização</dt>
              <dd id="cameraDetalheLocalizacao">—</dd>
            </div>
            <div>
              <dt>Observações</dt>
              <dd id="cameraDetalheObservacoes">—</dd>
            </div>
          </dl>
        </div>
      </div>

      <footer class="modal-foot">
        <a href="/caixas" class="btn secondary">Ver todas as caixas →</a>
      </footer>
    </div>
  </div>

  <script src="/js/mapa.js?v=<%= assetVersion %>"></script>
</body>
</html>
