<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> | CFTV Mapeamento</title>
  <link rel="stylesheet" href="/css/login.css?v=<%= assetVersion %>">
</head>
<body class="login-body">
  <div class="login-shell">
    <section class="login-brand">
      <span class="login-logo" aria-hidden="true">▣</span>
      <h1>Mapeamento de infraestrutura de CFTV</h1>
      <p>Acesse o painel para consultar caixas técnicas, switches, câmeras e documentos do projeto.</p>
      <div class="login-brand-line"></div>
    </section>

    <section class="login-card">
      <h2>Entrar</h2>

      <% if (erro) { %>
        <div class="alert-error" role="alert">
          <%= erro %>
        </div>
      <% } %>

      <form method="post" action="/login">
        <div class="form-group">
          <label for="email">E-mail</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="username"
            required
            autofocus
          >
        </div>

        <div class="form-group">
          <label for="senha">Senha</label>
          <input
            id="senha"
            name="senha"
            type="password"
            autocomplete="current-password"
            required
          >
        </div>

        <button type="submit">Entrar</button>
      </form>

      <footer>
        <small>Área restrita a usuários autorizados.</small>
      </footer>
    </section>
  </div>
</body>
</html>
