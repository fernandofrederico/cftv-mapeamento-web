<aside class="sidebar">
  <div class="brand">
    <strong>CFTV</strong>
    <small>Mapeamento</small>
  </div>

  <a href="/dashboard" class="nav-btn <%= active === 'dashboard' ? 'active' : '' %>">
    <span aria-hidden="true">▣</span> Dashboard
  </a>

  <a href="/caixas" class="nav-btn <%= active === 'caixas' ? 'active' : '' %>">
    <span aria-hidden="true">▦</span> Caixas e switches
  </a>

  <a href="/mapa" class="nav-btn <%= active === 'mapa' ? 'active' : '' %>">
    <span aria-hidden="true">⌖</span> Mapa
  </a>

  <a href="/cameras" class="nav-btn <%= active === 'cameras' ? 'active' : '' %>">
    <span aria-hidden="true">◉</span> Câmeras
  </a>

  <a href="/diagrama" class="nav-btn <%= active === 'diagrama' ? 'active' : '' %>">
    <span aria-hidden="true">◇</span> Diagrama
  </a>

  <a href="/documentos" class="nav-btn <%= active === 'documentos' ? 'active' : '' %>">
    <span aria-hidden="true">▤</span> Documentos
  </a>

  <% if (usuario.perfil === 'administrador') { %>
    <a href="/usuarios" class="nav-btn <%= active === 'usuarios' ? 'active' : '' %>">
      <span aria-hidden="true">☺</span> Usuários
    </a>
  <% } %>

  <div class="sidebar-spacer"></div>

  <a href="/minha-conta" class="current-user <%= active === 'minha-conta' ? 'active' : '' %>">
    <strong><%= usuario.nome %></strong>
    <small><%= usuario.email %></small>
  </a>

  <form method="post" action="/logout">
    <button type="submit" class="sidebar-util">⏻ Sair</button>
  </form>
</aside>
