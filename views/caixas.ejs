<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> | CFTV Mapeamento</title>
  <link rel="stylesheet" href="/css/app-shell.css">
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'caixas', usuario: usuario }) %>

    <main class="main">
      <header class="topbar">
        <div>
          <p class="eyebrow">Cadastro técnico</p>
          <h1>Caixas técnicas e switches PoE</h1>
        </div>
      </header>

      <div class="content">
        <div class="heading-row" style="display:flex;justify-content:space-between;align-items:center;">
          <p>
            Consulte localização, identificação do switch, endereço IP,
            portas e quantidade de câmeras.
          </p>
          <strong class="badge-count" style="font-size:14px;padding:6px 14px;">
            <%= caixas.length %> caixas
          </strong>
        </div>

        <% if (caixas.length === 0) { %>
          <div class="empty-state">
            <h3>Nenhuma caixa cadastrada</h3>
            <p>Não existem registros disponíveis no banco de dados.</p>
          </div>
        <% } else { %>
          <div class="table-card">
            <table>
              <thead>
                <tr>
                  <th>Código</th>
                  <th>Descrição</th>
                  <th>Localização</th>
                  <th>Switch</th>
                  <th>IP do switch</th>
                  <th>Portas</th>
                  <th>Câmeras</th>
                  <th>Fotos</th>
                </tr>
              </thead>
              <tbody>
                <% caixas.forEach((caixa) => { %>
                  <tr>
                    <td><code><%= caixa.codigo %></code></td>
                    <td><%= caixa.descricao || 'Caixa técnica' %></td>
                    <td><%= caixa.localizacao || 'Não informada' %></td>
                    <td><%= caixa.switch_nome || 'Não informado' %></td>
                    <td><code><%= caixa.switch_ip || 'Não informado' %></code></td>
                    <td><%= caixa.switch_portas %></td>
                    <td>
                      <span class="badge-count"><%= caixa.total_cameras %></span>
                    </td>
                    <td>
                      <span class="foto-status <%= caixa.foto_painel ? 'com-foto' : 'sem-foto' %>">
                        Painel
                      </span>
                      <span class="foto-status <%= caixa.foto_switch ? 'com-foto' : 'sem-foto' %>">
                        Switch
                      </span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>
